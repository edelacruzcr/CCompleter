  "Array Estático": {
    "scope": "c,cpp",
    "prefix": ["a", "ar", "arr", "array"],
    "body": ["${1|int,float,double,char|} ${2:nombre}[${3:100}];"],
    "description": "Declarar array estático"
  },
  "Array Inicializado": {
    "scope": "c,cpp",
    "prefix": ["array_init", "arr_init"],
    "body": ["${1:tipo} ${2:nombre}[] = {${3:1, 2, 3, 4, 5}};"],
    "description": "Declarar array con inicialización"
  },
  "Array Dinámico (malloc)": {
    "scope": "c,cpp",
    "prefix": ["array_malloc", "arr_dyn"],
    "body": [
      "${1:tipo} *${2:nombre} = (${1:tipo}*)malloc(${3:tamaño} * sizeof(${1:tipo}));",
      "if (${2:nombre} == NULL) {",
      "\tperror(\"Error al asignar memoria\");",
      "\texit(1);",
      "}"
    ],
    "description": "Crear array dinámico con malloc y verificación"
  },
  "Array Dinámico (calloc)": {
    "scope": "c,cpp",
    "prefix": ["array_calloc", "arr_calloc"],
    "body": [
      "${1:tipo} *${2:nombre} = (${1:tipo}*)calloc(${3:tamaño}, sizeof(${1:tipo}));",
      "if (${2:nombre} == NULL) {",
      "\tperror(\"Error al asignar memoria\");",
      "\texit(1);",
      "}"
    ],
    "description": "Crear array dinámico con calloc (inicializado en cero)"
  },
  "Array 2D Estático": {
    "scope": "c,cpp",
    "prefix": ["array2d", "matriz"],
    "body": ["${1:tipo} ${2:nombre}[${3:filas}][${4:columnas}];"],
    "description": "Declarar matriz 2D estática"
  },
  "Array 2D Dinámico": {
    "scope": "c,cpp",
    "prefix": ["array2d_malloc", "matriz_dyn"],
    "body": [
      "${1:tipo} **${2:nombre} = (${1:tipo}**)malloc(${3:filas} * sizeof(${1:tipo}*));",
      "for (int i = 0; i < ${3:filas}; i++) {",
      "\t${2:nombre}[i] = (${1:tipo}*)malloc(${4:columnas} * sizeof(${1:tipo}));",
      "}"
    ],
    "description": "Crear matriz dinámica 2D"
  },
  "Array de Caracteres": {
    "scope": "c,cpp",
    "prefix": ["str_array", "char_array"],

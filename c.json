  "Main Básico": {
    "scope": "c,cpp",
    "prefix": ["main", "principal"],
    "body": [
      "#include <stdio.h>",
      "",
      "int main(void) {",
      "\t${1:// Código}",
      "\treturn 0;",
      "}"
    ],
    "description": "Estructura main básica"
  },
  "Main con Argumentos": {
    "scope": "c,cpp",
    "prefix": ["mainargs", "main_argc"],
    "body": [
      "#include <stdio.h>",
      "",
      "int main(int argc, char *argv[]) {",
      "\t${1:// Código}",
      "\treturn 0;",
      "}"
    ],
    "description": "Estructura main con argc y argv"
  },

  
  "Comentario de Bloque": {
    "scope": "c,cpp",
    "prefix": ["c", "co", "com", "comm", "commen", "comment", "comenta", "comentari", "comentario", "/*"],
    "body": ["/*", " * ${1:Descripción}", " */"],
    "description": "Comentario de bloque"
  },
  "Comentario de Línea": {
    "scope": "c,cpp",
    "prefix": ["com_linea", "//"],
    "body": ["// ${1:Comentario}"],
    "description": "Comentario de línea"
  },
  "Comentario de Documentación": {
    "scope": "c,cpp",
    "prefix": ["doc", "/**"],
    "body": [
      "/**",
      " * @brief ${1:Descripción breve}",
      " * @param ${2:parametro} ${3:descripción}",
      " * @return ${4:valor de retorno}",
      " */"
    ],
    "description": "Comentario de documentación estilo Doxygen"
  },

  
  "Variable con tipo (menú)": {
    "scope": "c,cpp",
    "prefix": [ "t", "ti", "tip", "tipo", "v", "var"],
    "body": ["${1|int,float,double,char,bool,unsigned int,size_t|} ${2:nombre} = ${3:0};"],
    "description": "Declarar variable de tipo común"
  },
  "Variable Int": {
    "scope": "c,cpp",

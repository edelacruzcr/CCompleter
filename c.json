  "Vector dinámico simple": {
    "scope": "c,cpp",
    "prefix": ["vector", "lista_simple"],
    "body": [
      "typedef struct {",
      "\t${1|int,float,double,char*|} *datos;",
      "\tint tamaño;",
      "\tint capacidad;",
      "} Vector;",
      "",
      "// Inicializar vector",
      "void vector_init(Vector *v, int capacidad_inicial) {",
      "\tv->datos = (${1}*)malloc(capacidad_inicial * sizeof(${1}));",
      "\tv->tamaño = 0;",
      "\tv->capacidad = capacidad_inicial;",
      "}",
      "",
      "// Agregar elemento",
      "void vector_agregar(Vector *v, ${1} valor) {",
      "\tif (v->tamaño >= v->capacidad) {",
      "\t\tv->capacidad *= 2;",
      "\t\tv->datos = (${1}*)realloc(v->datos, v->capacidad * sizeof(${1}));",
      "\t}",
      "\tv->datos[v->tamaño++] = valor;",
      "}",
      "",
      "// Obtener elemento",
      "${1} vector_obtener(Vector *v, int indice) {",
      "\tif (indice >= 0 && indice < v->tamaño) {",
      "\t\treturn v->datos[indice];",
      "\t}",
      "\treturn (${1})0;",
      "}",
      "",
      "// Liberar vector",
      "void vector_liberar(Vector *v) {",
      "\tfree(v->datos);",
      "\tv->datos = NULL;",
      "\tv->tamaño = v->capacidad = 0;",
      "}",
      "",
      "// Uso:",
      "Vector vec;",
      "vector_init(&vec, 4);",
      "vector_agregar(&vec, ${2:valor1});",
      "vector_agregar(&vec, ${3:valor2});",
      "printf(\"Elemento 0: %${4|d,f,s|}\\n\", vector_obtener(&vec, 0));",
      "vector_liberar(&vec);"
    ],
    "description": "Vector dinámico genérico con funciones básicas"
  },

  "Ordenamiento burbuja (menú dirección)": {
    "scope": "c,cpp",
    "prefix": ["ordenar", "sort", "burbuja"],
    "body": [
      "void ordenar_burbuja(${1|int,float,double|} arr[], int n, int ascendente) {",
      "\tfor (int i = 0; i < n-1; i++) {",
      "\t\tfor (int j = 0; j < n-i-1; j++) {",
      "\t\t\tif ((ascendente && arr[j] > arr[j+1]) || (!ascendente && arr[j] < arr[j+1])) {",
      "\t\t\t\t${1} temp = arr[j];",
      "\t\t\t\tarr[j] = arr[j+1];",
      "\t\t\t\tarr[j+1] = temp;",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "}",
      "",
      "// Uso:",
      "${1} datos[] = {${2:5, 2, 8, 1, 9}};",
      "int n = sizeof(datos)/sizeof(datos[0]);",
      "ordenar_burbuja(datos, n, ${3:1}); // 1 ascendente, 0 descendente"
    ],
    "description": "Ordena un array con el método burbuja"
  },


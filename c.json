      "int es_primo(int n) {",
      "\tif (n <= 1) return 0;",
      "\tfor (int i = 2; i * i <= n; i++) {",
      "\t\tif (n % i == 0) return 0;",
      "\t}",
      "\treturn 1;",
      "}",
      "",
      "// Uso:",
      "if (es_primo(${1:17})) printf(\"Es primo\\n\");"
    ],

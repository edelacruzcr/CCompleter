{
  "Include Estándar stdio": {
    "scope": "c,cpp",
    "prefix": ["inc_stdio", "#include <stdio.h>"],
    "body": ["#include <stdio.h>"],
    "description": "Incluir stdio.h"
  },
  "Include Estándar stdlib": {
    "scope": "c,cpp",
    "prefix": ["inc_stdlib", "#include <stdlib.h>"],
    "body": ["#include <stdlib.h>"],
    "description": "Incluir stdlib.h"
  },
  "Include Estándar string": {
    "scope": "c,cpp",
    "prefix": ["inc_string", "#include <string.h>"],
    "body": ["#include <string.h>"],
    "description": "Incluir string.h"
  },
  "Include Estándar math": {
    "scope": "c,cpp",
    "prefix": ["inc_math", "#include <math.h>"],
    "body": ["#include <math.h>"],
    "description": "Incluir math.h"
  },
  "Include Estándar bool": {
    "scope": "c,cpp",
    "prefix": ["inc_bool", "#include <stdbool.h>"],
    "body": ["#include <stdbool.h>"],
    "description": "Incluir stdbool.h"
  },
  "Include Estándar time": {
    "scope": "c,cpp",
    "prefix": ["inc_time", "#include <time.h>"],
    "body": ["#include <time.h>"],
    "description": "Incluir time.h"
  },
  "Include Todos los Comunes": {
    "scope": "c,cpp",
    "prefix": ["inc_todos", "includes_comunes", "all_headers"],
    "body": [
      "#include <stdio.h>",
      "#include <stdlib.h>",
      "#include <string.h>",
      "#include <stdbool.h>",
      "#include <math.h>"
    ],
    "description": "Incluir headers más comunes de una vez"
  },
  "Main Básico": {
    "scope": "c,cpp",
    "prefix": ["main", "principal", "programa"],
    "body": [
      "#include <stdio.h>",
      "",
      "int main(void) {",
      "\t${1:// Código}",
      "\treturn 0;",
      "}"
    ],
    "description": "Estructura main básica"
  },
  "Main con Argumentos": {
    "scope": "c,cpp",
    "prefix": ["mainargs", "main_args", "main_argc"],
    "body": [
      "#include <stdio.h>",
      "",
      "int main(int argc, char *argv[]) {",
      "\t${1:// Código}",
      "\treturn 0;",
      "}"
    ],
    "description": "Estructura main con argc y argv"
  },
  "Comentario de Bloque": {
    "scope": "c,cpp",
    "prefix": ["comentario", "comment", "/*"],
    "body": [
      "/*",
      " * ${1:Descripción}",
      " */"
    ],
    "description": "Comentario de bloque"
  },
  "Comentario de Línea": {
    "scope": "c,cpp",
    "prefix": ["com_linea", "//"],
    "body": ["// ${1:Comentario}"],
    "description": "Comentario de línea"
  },
  "Comentario de Documentación": {
    "scope": "c,cpp",
    "prefix": ["doc", "documentacion", "/**"],
    "body": [
      "/**",
      " * @brief ${1:Descripción breve}",
      " * @param ${2:parametro} ${3:descripción}",
      " * @return ${4:valor de retorno}",
      " */"
    ],
    "description": "Comentario de documentación estilo Doxygen"
  },
  "Variable Int": {
    "scope": "c,cpp",
    "prefix": ["vint", "int_var", "var_int"],
    "body": ["int ${1:nombre} = ${2:0};"],
    "description": "Declarar variable entera"
  },
  "Variable Float": {
    "scope": "c,cpp",
    "prefix": ["vfloat", "float_var", "var_float"],
    "body": ["float ${1:nombre} = ${2:0.0f};"],
    "description": "Declarar variable flotante"
  },
  "Variable Double": {
    "scope": "c,cpp",
    "prefix": ["vdouble", "double_var", "var_double"],
    "body": ["double ${1:nombre} = ${2:0.0};"],
    "description": "Declarar variable double"
  },
  "Variable Char": {
    "scope": "c,cpp",
    "prefix": ["vchar", "char_var", "var_char"],
    "body": ["char ${1:nombre} = '${2:a}';"],
    "description": "Declarar variable char"
  },
  "Variable Bool": {
    "scope": "c,cpp",
    "prefix": ["vbool", "bool_var", "var_bool"],
    "body": ["bool ${1:nombre} = ${2:true};"],
    "description": "Declarar variable booleana (requiere stdbool.h)"
  },
  "Variable String (array)": {
    "scope": "c,cpp",
    "prefix": ["vstring", "str_var", "var_string"],
    "body": ["char ${1:nombre}[${2:100}] = \"${3:texto}\";"],
    "description": "Declarar cadena como array de caracteres"
  },
  "Variable Puntero": {
    "scope": "c,cpp",
    "prefix": ["vptr", "puntero", "var_ptr"],
    "body": ["${1:tipo} *${2:nombre} = ${3:NULL};"],
    "description": "Declarar puntero de cualquier tipo"
  },
  "Variable Constante": {
    "scope": "c,cpp",
    "prefix": ["vconst", "constante", "var_const"],
    "body": ["const ${1:tipo} ${2:NOMBRE} = ${3:valor};"],
    "description": "Declarar constante"
  },
  "Variable Estática": {
    "scope": "c,cpp",
    "prefix": ["vstatic", "static_var", "var_static"],
    "body": ["static ${1:tipo} ${2:nombre} = ${3:valor};"],
    "description": "Declarar variable estática"
  },
  "Variable Extern": {
    "scope": "c,cpp",
    "prefix": ["vextern", "extern_var"],
    "body": ["extern ${1:tipo} ${2:nombre};"],
    "description": "Declarar variable externa"
  },
  "Variable unsigned int": {
    "scope": "c,cpp",
    "prefix": ["vuint", "unsigned_int"],
    "body": ["unsigned int ${1:nombre} = ${2:0};"],
    "description": "Declarar entero sin signo"
  },
  "Variable size_t": {
    "scope": "c,cpp",
    "prefix": ["vsize", "size_t_var"],
    "body": ["size_t ${1:nombre} = ${2:0};"],
    "description": "Declarar size_t"
  },
  "Múltiples variables enteras": {
    "scope": "c,cpp",
    "prefix": ["vints", "multi_int"],
    "body": ["int ${1:a} = 0, ${2:b} = 0, ${3:c} = 0;"],
    "description": "Declarar varias variables enteras"
  },
  "Array Estático": {
    "scope": "c,cpp",
    "prefix": ["array", "arr", "array_static"],
    "body": ["${1:tipo} ${2:nombre}[${3:100}];"],
    "description": "Declarar array estático"
  },
  "Array Inicializado": {
    "scope": "c,cpp",
    "prefix": ["array_init", "arr_init"],
    "body": ["${1:tipo} ${2:nombre}[] = {${3:1, 2, 3, 4, 5}};"],
    "description": "Declarar array con inicialización"
  },
  "Array Dinámico (malloc)": {
    "scope": "c,cpp",
    "prefix": ["array_malloc", "arr_dyn", "array_dinamico"],
    "body": [
      "${1:tipo} *${2:nombre} = (${1:tipo}*)malloc(${3:tamaño} * sizeof(${1:tipo}));",
      "if (${2:nombre} == NULL) {",
      "\tperror(\"Error al asignar memoria\");",
      "\texit(1);",
      "}"
    ],
    "description": "Crear array dinámico con malloc y verificación"
  },
  "Array Dinámico (calloc)": {
    "scope": "c,cpp",
    "prefix": ["array_calloc", "arr_calloc"],
    "body": [
      "${1:tipo} *${2:nombre} = (${1:tipo}*)calloc(${3:tamaño}, sizeof(${1:tipo}));",
      "if (${2:nombre} == NULL) {",
      "\tperror(\"Error al asignar memoria\");",
      "\texit(1);",
      "}"
    ],
    "description": "Crear array dinámico con calloc (inicializado en cero)"
  },
  "Array 2D Estático": {
    "scope": "c,cpp",
    "prefix": ["array2d", "matriz", "arr2d"],
    "body": ["${1:tipo} ${2:nombre}[${3:filas}][${4:columnas}];"],
    "description": "Declarar matriz 2D estática"
  },
  "Array 2D Dinámico": {
    "scope": "c,cpp",
    "prefix": ["array2d_malloc", "matriz_dyn"],
    "body": [
      "${1:tipo} **${2:nombre} = (${1:tipo}**)malloc(${3:filas} * sizeof(${1:tipo}*));",
      "for (int i = 0; i < ${3:filas}; i++) {",
      "\t${2:nombre}[i] = (${1:tipo}*)malloc(${4:columnas} * sizeof(${1:tipo}));",
      "}"
    ],
    "description": "Crear matriz dinámica 2D"
  },
  "Array de Caracteres": {
    "scope": "c,cpp",
    "prefix": ["str_array", "char_array"],
    "body": ["char ${1:nombre}[${2:100}];"],
    "description": "Declarar array de caracteres (string)"
  },
  "Recorrer Array con for": {
    "scope": "c,cpp",
    "prefix": ["for_array", "recorrer_array"],
    "body": [
      "for (int i = 0; i < ${1:tamaño}; i++) {",
      "\t${2:// Acceder a array[i]}",
      "}"
    ],
    "description": "Bucle for para recorrer array"
  },
  "malloc con Cast": {
    "scope": "c,cpp",
    "prefix": ["malloc", "asignar_memoria"],
    "body": [
      "${1:tipo} *${2:ptr} = (${1:tipo}*)malloc(sizeof(${1:tipo}));",
      "if (${2:ptr} == NULL) {",
      "\tperror(\"Error en malloc\");",
      "\texit(1);",
      "}"
    ],
    "description": "Asignar memoria para un elemento con verificación"
  },
  "calloc con Cast": {
    "scope": "c,cpp",
    "prefix": ["calloc", "asignar_calloc"],
    "body": [
      "${1:tipo} *${2:ptr} = (${1:tipo}*)calloc(${3:cantidad}, sizeof(${1:tipo}));",
      "if (${2:ptr} == NULL) {",
      "\tperror(\"Error en calloc\");",
      "\texit(1);",
      "}"
    ],
    "description": "Asignar memoria para varios elementos inicializados a cero"
  },
  "realloc con Cast": {
    "scope": "c,cpp",
    "prefix": ["realloc", "reagrandar_memoria"],
    "body": [
      "${1:tipo} *${2:temp} = (${1:tipo}*)realloc(${3:ptr}, ${4:nuevo_tamaño} * sizeof(${1:tipo}));",
      "if (${2:temp} == NULL) {",
      "\tperror(\"Error en realloc\");",
      "\texit(1);",
      "}",
      "${3:ptr} = ${2:temp};"
    ],
    "description": "Reasignar memoria con verificación y manejo seguro"
  },
  "free Seguro": {
    "scope": "c,cpp",
    "prefix": ["free", "liberar_memoria"],
    "body": [
      "if (${1:ptr} != NULL) {",
      "\tfree(${1:ptr});",
      "\t${1:ptr} = NULL;",
      "}"
    ],
    "description": "Liberar memoria de forma segura"
  },
  "malloc para String": {
    "scope": "c,cpp",
    "prefix": ["malloc_str", "string_malloc"],
    "body": [
      "char *${1:str} = (char*)malloc((${2:longitud} + 1) * sizeof(char));",
      "if (${1:str} == NULL) {",
      "\tperror(\"Error al asignar memoria para string\");",
      "\texit(1);",
      "}"
    ],
    "description": "Asignar memoria para cadena con espacio extra para terminador"
  },
  "strdup (duplicar cadena)": {
    "scope": "c,cpp",
    "prefix": ["strdup", "duplicar_string"],
    "body": [
      "char *${1:dest} = strdup(${2:origen});",
      "if (${1:dest} == NULL) {",
      "\tperror(\"Error en strdup\");",
      "\texit(1);",
      "}"
    ],
    "description": "Duplicar una cadena con verificación"
  },
  "Liberar matriz 2D": {
    "scope": "c,cpp",
    "prefix": ["free2d", "liberar_matriz"],
    "body": [
      "for (int i = 0; i < ${1:filas}; i++) {",
      "\tfree(${2:matriz}[i]);",
      "}",
      "free(${2:matriz});",
      "${2:matriz} = NULL;"
    ],
    "description": "Liberar memoria de matriz 2D"
  },
  "Bucle for clásico": {
    "scope": "c,cpp",
    "prefix": ["for", "bucle_for"],
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:limite}; ${1:i}++) {",
      "\t${3:// Código}",
      "}"
    ],
    "description": "Bucle for estándar"
  },
  "Bucle for descendente": {
    "scope": "c,cpp",
    "prefix": ["for_down", "for_descendente"],
    "body": [
      "for (int ${1:i} = ${2:inicio}; ${1:i} >= ${3:fin}; ${1:i}--) {",
      "\t${4:// Código}",
      "}"
    ],
    "description": "Bucle for descendente"
  },
  "Bucle for con paso": {
    "scope": "c,cpp",
    "prefix": ["for_step", "for_paso"],
    "body": [
      "for (int ${1:i} = ${2:inicio}; ${1:i} <= ${3:fin}; ${1:i} += ${4:paso}) {",
      "\t${5:// Código}",
      "}"
    ],
    "description": "Bucle for con incremento personalizado"
  },
  "Bucle while": {
    "scope": "c,cpp",
    "prefix": ["while", "bucle_while"],
    "body": [
      "while (${1:condicion}) {",
      "\t${2:// Código}",
      "}"
    ],
    "description": "Bucle while"
  },
  "Bucle do-while": {
    "scope": "c,cpp",
    "prefix": ["dowhile", "do_while"],
    "body": [
      "do {",
      "\t${1:// Código}",
      "} while (${2:condicion});"
    ],
    "description": "Bucle do-while"
  },
  "Bucle infinito": {
    "scope": "c,cpp",
    "prefix": ["loop", "infinito", "forever"],
    "body": [
      "for (;;) {",
      "\t${1:// Código}",
      "}"
    ],
    "description": "Bucle infinito"
  },
  "Bucle con break": {
    "scope": "c,cpp",
    "prefix": ["for_break", "bucle_break"],
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:limite}; ${1:i}++) {",
      "\tif (${3:condicion_para_salir}) break;",
      "\t${4:// Código}",
      "}"
    ],
    "description": "Bucle for con condición de salida"
  },
  "Bucle con continue": {
    "scope": "c,cpp",
    "prefix": ["for_continue", "bucle_continue"],
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:limite}; ${1:i}++) {",
      "\tif (${3:condicion_saltar}) continue;",
      "\t${4:// Código}",
      "}"
    ],
    "description": "Bucle for con salto condicional"
  },
  "If simple": {
    "scope": "c,cpp",
    "prefix": ["if", "condicional"],
    "body": [
      "if (${1:condicion}) {",
      "\t${2:// Código}",
      "}"
    ],
    "description": "Condicional if"
  },
  "If-else": {
    "scope": "c,cpp",
    "prefix": ["ifelse", "if_else"],
    "body": [
      "if (${1:condicion}) {",
      "\t${2:// Si verdadero}",
      "} else {",
      "\t${3:// Si falso}",
      "}"
    ],
    "description": "Condicional if-else"
  },
  "If-else if-else": {
    "scope": "c,cpp",
    "prefix": ["ifelseif", "if_elseif"],
    "body": [
      "if (${1:condicion1}) {",
      "\t${2:// Caso 1}",
      "} else if (${3:condicion2}) {",
      "\t${4:// Caso 2}",
      "} else {",
      "\t${5:// Caso por defecto}",
      "}"
    ],
    "description": "Condicional if-else if-else"
  },
  "Operador ternario": {
    "scope": "c,cpp",
    "prefix": ["ternario", "condicional_ternario"],
    "body": ["${1:variable} = (${2:condicion}) ? ${3:valor_verdadero} : ${4:valor_falso};"],
    "description": "Operador ternario"
  },
  "Switch-case": {
    "scope": "c,cpp",
    "prefix": ["switch", "seleccion"],
    "body": [
      "switch (${1:variable}) {",
      "\tcase ${2:VALOR1}:",
      "\t\t${3:// Código caso 1}",
      "\t\tbreak;",
      "\tcase ${4:VALOR2}:",
      "\t\t${5:// Código caso 2}",
      "\t\tbreak;",
      "\tdefault:",
      "\t\t${6:// Código por defecto}",
      "\t\tbreak;",
      "}"
    ],
    "description": "Estructura switch-case"
  },
  "Switch-case sin break": {
    "scope": "c,cpp",
    "prefix": ["switch_nobreak", "switch_fallthrough"],
    "body": [
      "switch (${1:variable}) {",
      "\tcase ${2:VALOR1}:",
      "\t\t${3:// Código compartido}",
      "\t\t/* fall through */",
      "\tcase ${4:VALOR2}:",
      "\t\t${5:// Código adicional}",
      "\t\tbreak;",
      "\tdefault:",
      "\t\tbreak;",
      "}"
    ],
    "description": "Switch con fallthrough intencional"
  },
  "Definir función": {
    "scope": "c,cpp",
    "prefix": ["func", "funcion", "definir_funcion"],
    "body": [
      "${1:tipo_retorno} ${2:nombre_funcion}(${3:parametros}) {",
      "\t${4:// Código}",
      "\treturn ${5:valor};",
      "}"
    ],
    "description": "Definir función"
  },
  "Prototipo de función": {
    "scope": "c,cpp",
    "prefix": ["proto", "prototipo"],
    "body": ["${1:tipo_retorno} ${2:nombre_funcion}(${3:parametros});"],
    "description": "Declarar prototipo de función"
  },
  "Función void": {
    "scope": "c,cpp",
    "prefix": ["funcvoid", "funcion_void"],
    "body": [
      "void ${1:nombre_funcion}(${2:parametros}) {",
      "\t${3:// Código}",
      "}"
    ],
    "description": "Función sin retorno"
  },
  "Función con puntero a función": {
    "scope": "c,cpp",
    "prefix": ["funcptr", "puntero_funcion"],
    "body": [
      "${1:tipo_retorno} (*${2:nombre_ptr})(${3:parametros}) = ${4:&funcion};",
      "",
      "// Llamada:",
      "${2:nombre_ptr}(${5:argumentos});"
    ],
    "description": "Declarar y usar puntero a función"
  },
  "Función estática": {
    "scope": "c,cpp",
    "prefix": ["funcstatic", "funcion_static"],
    "body": [
      "static ${1:tipo_retorno} ${2:nombre_funcion}(${3:parametros}) {",
      "\t${4:// Código}",
      "\treturn ${5:valor};",
      "}"
    ],
    "description": "Función estática (visible solo en el archivo)"
  },
  "Función inline": {
    "scope": "c,cpp",
    "prefix": ["funcinline", "funcion_inline"],
    "body": [
      "static inline ${1:tipo_retorno} ${2:nombre_funcion}(${3:parametros}) {",
      "\t${4:// Código}",
      "\treturn ${5:valor};",
      "}"
    ],
    "description": "Función inline (sugerencia al compilador)"
  },
  "Struct simple": {
    "scope": "c,cpp",
    "prefix": ["struct", "estructura"],
    "body": [
      "typedef struct {",
      "\t${1:int id};",
      "\t${2:char nombre[50]};",
      "\t${3:float precio};",
      "} ${4:NombreStruct};"
    ],
    "description": "Definir estructura con typedef"
  },
  "Struct con nombre": {
    "scope": "c,cpp",
    "prefix": ["struct_named", "estructura_nombrada"],
    "body": [
      "typedef struct ${1:NombreTag} {",
      "\t${2:int id};",
      "\t${3:char nombre[50]};",
      "} ${4:NombreStruct};"
    ],
    "description": "Definir estructura con etiqueta y typedef"
  },
  "Struct anónima": {
    "scope": "c,cpp",
    "prefix": ["struct_anon", "estructura_anonima"],
    "body": [
      "struct {",
      "\t${1:int id};",
      "\t${2:char nombre[50]};",
      "} ${3:variable};"
    ],
    "description": "Definir estructura anónima con variable"
  },
  "Unión": {
    "scope": "c,cpp",
    "prefix": ["union", "union_tipo"],
    "body": [
      "typedef union {",
      "\t${1:int entero};",
      "\t${2:float flotante};",
      "\t${3:char caracter};",
      "} ${4:NombreUnion};"
    ],
    "description": "Definir unión"
  },
  "Inicializar struct": {
    "scope": "c,cpp",
    "prefix": ["struct_init", "init_struct"],
    "body": ["${1:NombreStruct} ${2:variable} = {${3:0}, ${4:\"\"}, ${5:0.0}};"],
    "description": "Inicializar estructura con valores"
  },
  "Acceder a miembro de struct": {
    "scope": "c,cpp",
    "prefix": ["struct_member", "acceder_miembro"],
    "body": ["${1:variable}.${2:miembro} = ${3:valor};"],
    "description": "Acceder a miembro de estructura (operador punto)"
  },
  "Acceder a miembro por puntero": {
    "scope": "c,cpp",
    "prefix": ["struct_ptr", "acceder_ptr_struct"],
    "body": ["${1:puntero}->${2:miembro} = ${3:valor};"],
    "description": "Acceder a miembro por puntero (operador flecha)"
  },
  "Enum simple": {
    "scope": "c,cpp",
    "prefix": ["enum", "enumeracion"],
    "body": [
      "typedef enum {",
      "\t${1:OPCION1},",
      "\t${2:OPCION2},",
      "\t${3:OPCION3}",
      "} ${4:NombreEnum};"
    ],
    "description": "Definir enumeración"
  },
  "Enum con valores explícitos": {
    "scope": "c,cpp",
    "prefix": ["enum_val", "enumeracion_valores"],
    "body": [
      "typedef enum {",
      "\t${1:OPCION1} = ${2:1},",
      "\t${3:OPCION2} = ${4:2},",
      "\t${5:OPCION3} = ${6:4}",
      "} ${7:NombreEnum};"
    ],
    "description": "Definir enumeración con valores específicos"
  },
  "Puntero básico": {
    "scope": "c,cpp",
    "prefix": ["ptr", "puntero_basico"],
    "body": [
      "${1:tipo} *${2:ptr} = &${3:variable};",
      "${4:// Usar *${2:ptr} para acceder al valor}"
    ],
    "description": "Declarar puntero y asignar dirección"
  },
  "Puntero NULL": {
    "scope": "c,cpp",
    "prefix": ["ptr_null", "puntero_null"],
    "body": ["${1:tipo} *${2:ptr} = NULL;"],

  "strtok": {
    "scope": "c,cpp",
    "prefix": ["stot", "stro", "strtok", "dividir_cadena"],
    "body": [
      "char *${1:token} = strtok(${2:cadena}, \"${3:delimitadores}\");",
      "while (${1:token} != NULL) {",
      "\t${4:// Procesar token}",
      "\t${1:token} = strtok(NULL, \"${3:delimitadores}\");",
      "}"
    ],
    "description": "Dividir cadena en tokens"
  },

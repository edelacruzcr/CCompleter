      "\tNodo *actual = cabeza;",
      "\twhile (actual != NULL) {",
      "\t\tprintf(\"%${2|d,f,s|} -> \", actual->dato);",
      "\t\tactual = actual->siguiente;",
      "\t}",
      "\tprintf(\"NULL\\n\");",
      "}",
      "",
      "// Uso:",
      "Nodo *miLista = NULL;",
      "insertar_inicio(&miLista, ${3:valor1});",
      "insertar_inicio(&miLista, ${4:valor2});",
      "imprimir_lista(miLista);"
    ],
    "description": "Lista enlazada con tipo de dato seleccionable"
  },



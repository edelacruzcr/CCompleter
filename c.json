  "Lista enlazada simple (int)": {
    "scope": "c,cpp",
    "prefix": ["list", "lista", "linked"],
    "body": [
      "typedef struct Nodo {",
      "\tint dato;",
      "\tstruct Nodo *siguiente;",
      "} Nodo;",
      "",
      "// Insertar al inicio",
      "void insertar_inicio(Nodo **cabeza, int valor) {",
      "\tNodo *nuevo = (Nodo*)malloc(sizeof(Nodo));",
      "\tnuevo->dato = valor;",
      "\tnuevo->siguiente = *cabeza;",
      "\t*cabeza = nuevo;",
      "}",
      "",
      "// Imprimir lista",
      "void imprimir_lista(Nodo *cabeza) {",
      "\tNodo *actual = cabeza;",
      "\twhile (actual != NULL) {",
      "\t\tprintf(\"%d -> \", actual->dato);",
      "\t\tactual = actual->siguiente;",
      "\t}",
      "\tprintf(\"NULL\\n\");",
      "}",
      "",
      "// Liberar lista",
      "void liberar_lista(Nodo *cabeza) {",
      "\tNodo *actual = cabeza;",
      "\twhile (actual != NULL) {",
      "\t\tNodo *temp = actual;",
      "\t\tactual = actual->siguiente;",
      "\t\tfree(temp);",
      "\t}",
      "}",
      "",
      "// Uso:",
      "Nodo *miLista = NULL;",
      "insertar_inicio(&miLista, ${1:10});",
      "insertar_inicio(&miLista, ${2:20});",
      "imprimir_lista(miLista);",
      "liberar_lista(miLista);"
    ],
    "description": "Lista enlazada de enteros con funciones básicas"
  },

  "Lista enlazada con menú de tipo": {

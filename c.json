  "Búsqueda binaria": {
    "scope": "c,cpp",
    "prefix": ["busqueda_binaria", "binary_search"],
    "body": [
      "int busqueda_binaria(int arr[], int izquierda, int derecha, int objetivo) {",
      "\twhile (izquierda <= derecha) {",
      "\t\tint medio = izquierda + (derecha - izquierda) / 2;",
      "\t\tif (arr[medio] == objetivo) return medio;",
      "\t\tif (arr[medio] < objetivo) izquierda = medio + 1;",
      "\t\telse derecha = medio - 1;",
      "\t}",
      "\treturn -1;",
      "}",
      "",
      "// Uso (array debe estar ordenado):",
      "int pos = busqueda_binaria(datos, 0, n-1, ${1:objetivo});"
    ],
    "description": "Búsqueda binaria en array ordenado"
  },


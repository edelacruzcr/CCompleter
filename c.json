  "Leer archivo completo a string": {
    "scope": "c,cpp",
    "prefix": ["leer_archivo_completo", "file_readall"],
    "body": [
      "char* leer_archivo_completo(const char *nombre_archivo) {",
      "\tFILE *fp = fopen(nombre_archivo, \"r\");",
      "\tif (fp == NULL) return NULL;",
      "",
      "\tfseek(fp, 0, SEEK_END);",
      "\tlong tamaño = ftell(fp);",
      "\tfseek(fp, 0, SEEK_SET);",
      "",
      "\tchar *contenido = (char*)malloc(tamaño + 1);",
      "\tif (contenido == NULL) {",
      "\t\tfclose(fp);",
      "\t\treturn NULL;",
      "\t}",
      "",
      "\tfread(contenido, 1, tamaño, fp);",
      "\tcontenido[tamaño] = '\\0';",
      "\tfclose(fp);",
      "\treturn contenido;",
      "}",
      "",
      "// Uso:",
      "char *texto = leer_archivo_completo(\"${1:archivo.txt}\");",
      "if (texto) {",
      "\tprintf(\"%s\\n\", texto);",
      "\tfree(texto);",
      "}"
    ],
    "description": "Lee todo el contenido de un archivo y lo devuelve como string"
  }

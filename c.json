    "description": "Declarar array de caracteres (string)"
  },
  "Recorrer Array con for": {
    "scope": "c,cpp",
    "prefix": ["for_array", "recorrer_array"],
    "body": [
      "for (int i = 0; i < ${1:tamaño}; i++) {",
      "\t${2:// Acceder a array[i]}",
      "}"
    ],
    "description": "Bucle for para recorrer array"
  },

  
  "Asignación de memoria (menú)": {
    "scope": "c,cpp",
    "prefix": [ "m", "ma", "mal", "mall", "malloc", "mem", "asignar_memoria"],
    "body": [
      "${1|malloc,calloc,realloc|}",
      "if (${1} == \"malloc\") {",
      "\t${2:tipo} *${3:ptr} = (${2:tipo}*)malloc(${4:tamaño} * sizeof(${2:tipo}));",
      "} else if (${1} == \"calloc\") {",
      "\t${2:tipo} *${3:ptr} = (${2:tipo}*)calloc(${4:tamaño}, sizeof(${2:tipo}));",
      "} else {",
      "\t${2:tipo} *${3:ptr} = (${2:tipo}*)realloc(${5:ptr_original}, ${4:tamaño} * sizeof(${2:tipo}));",
      "}",
      "if (${3:ptr} == NULL) {",
      "\tperror(\"Error de memoria\");",
      "\texit(1);",
      "}"
    ],
    "description": "Asignar memoria eligiendo función"
  },
  "malloc con Cast": {
    "scope": "c,cpp",
    "prefix": ["malloc"],
    "body": [
      "${1:tipo} *${2:ptr} = (${1:tipo}*)malloc(sizeof(${1:tipo}));",
      "if (${2:ptr} == NULL) {",
      "\tperror(\"Error en malloc\");",
      "\texit(1);",
      "}"
    ],
    "description": "Asignar memoria para un elemento con verificación"
  },
  "calloc con Cast": {
    "scope": "c,cpp",
    "prefix": ["calloc"],
    "body": [
      "${1:tipo} *${2:ptr} = (${1:tipo}*)calloc(${3:cantidad}, sizeof(${1:tipo}));",
      "if (${2:ptr} == NULL) {",
      "\tperror(\"Error en calloc\");",
      "\texit(1);",
      "}"
    ],
    "description": "Asignar memoria para varios elementos inicializados a cero"
  },
  "realloc con Cast": {
    "scope": "c,cpp",
    "prefix": ["realloc"],
    "body": [
      "${1:tipo} *${2:temp} = (${1:tipo}*)realloc(${3:ptr}, ${4:nuevo_tamaño} * sizeof(${1:tipo}));",
      "if (${2:temp} == NULL) {",
      "\tperror(\"Error en realloc\");",
      "\texit(1);",
      "}",
      "${3:ptr} = ${2:temp};"
    ],
    "description": "Reasignar memoria con verificación y manejo seguro"
  },
  "free Seguro": {
    "scope": "c,cpp",
    "prefix": ["free", "liberar_memoria"],
    "body": [
      "if (${1:ptr} != NULL) {",
      "\tfree(${1:ptr});",
      "\t${1:ptr} = NULL;",
      "}"
    ],
    "description": "Liberar memoria de forma segura"
  },
  "malloc para String": {
    "scope": "c,cpp",
    "prefix": ["malloc_str", "string_malloc"],
    "body": [
      "char *${1:str} = (char*)malloc((${2:longitud} + 1) * sizeof(char));",
      "if (${1:str} == NULL) {",
      "\tperror(\"Error al asignar memoria para string\");",
      "\texit(1);",
      "}"
    ],
    "description": "Asignar memoria para cadena con espacio extra para terminador"
  },
  "strdup (duplicar cadena)": {
    "scope": "c,cpp",
    "prefix": ["strdup", "duplicar_string"],
    "body": [
      "char *${1:dest} = strdup(${2:origen});",
      "if (${1:dest} == NULL) {",
      "\tperror(\"Error en strdup\");",
      "\texit(1);",
      "}"
    ],
    "description": "Duplicar una cadena con verificación"
  },
  "Liberar matriz 2D": {
    "scope": "c,cpp",
    "prefix": ["free2d", "liberar_matriz"],
    "body": [
      "for (int i = 0; i < ${1:filas}; i++) {",
      "\tfree(${2:matriz}[i]);",
      "}",
      "free(${2:matriz});",
      "${2:matriz} = NULL;"
    ],
    "description": "Liberar memoria de matriz 2D"
  },


  "Bucle for (menú)": {
    "scope": "c,cpp",
    "prefix": ["for", "bucle_for"],
    "body": [
      "${1|Clásico,Descendente,Con paso,Infinito|}",
      "switch (${1}) {",
      "\tcase \"Clásico\":",
      "\t\tfor (int ${2:i} = 0; ${2:i} < ${3:limite}; ${2:i}++) {",
      "\t\t\t${4:// código}",
      "\t\t}",
      "\t\tbreak;",
      "\tcase \"Descendente\":",
      "\t\tfor (int ${2:i} = ${5:inicio}; ${2:i} >= ${6:fin}; ${2:i}--) {",
      "\t\t\t${4:// código}",
      "\t\t}",
      "\t\tbreak;",
      "\tcase \"Con paso\":",
      "\t\tfor (int ${2:i} = ${5:inicio}; ${2:i} <= ${6:fin}; ${2:i} += ${7:paso}) {",
      "\t\t\t${4:// código}",
      "\t\t}",
      "\t\tbreak;",
      "\tcase \"Infinito\":",
      "\t\tfor (;;) {",
      "\t\t\t${4:// código}",
      "\t\t}",
      "\t\tbreak;",
      "}"
    ],
    "description": "Elige tipo de bucle for"
  },
  "Bucle while": {
    "scope": "c,cpp",
    "prefix": ["while", "bucle_while"],
    "body": ["while (${1:condicion}) {", "\t${2:// Código}", "}"],
    "description": "Bucle while"
  },
  "Bucle do-while": {
    "scope": "c,cpp",
    "prefix": ["dowhile", "do_while"],
    "body": ["do {", "\t${1:// Código}", "} while (${2:condicion});"],
    "description": "Bucle do-while"
  },
  "Bucle con break": {
    "scope": "c,cpp",
    "prefix": ["for_break", "bucle_break"],
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:limite}; ${1:i}++) {",
      "\tif (${3:condicion_para_salir}) break;",
      "\t${4:// Código}",
      "}"
    ],
    "description": "Bucle for con condición de salida"
  },
  "Bucle con continue": {
    "scope": "c,cpp",
    "prefix": ["for_continue", "bucle_continue"],
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:limite}; ${1:i}++) {",

  "Figuras con asteriscos (menú)": {
    "scope": "c,cpp",
    "prefix": ["figura", "patron", "asteriscos"],
    "body": [
      "${1|Cuadrado,Triángulo rectángulo,Triángulo equilátero,Pirámide,Rombo|}",
      "int n = ${2:5}; // tamaño",
      "",
      "if (${1} == \"Cuadrado\") {",
      "\tfor (int i = 0; i < n; i++) {",
      "\t\tfor (int j = 0; j < n; j++) {",
      "\t\t\tprintf(\"* \");",
      "\t\t}",
      "\t\tprintf(\"\\n\");",
      "\t}",
      "} else if (${1} == \"Triángulo rectángulo\") {",
      "\tfor (int i = 1; i <= n; i++) {",
      "\t\tfor (int j = 1; j <= i; j++) {",
      "\t\t\tprintf(\"* \");",
      "\t\t}",
      "\t\tprintf(\"\\n\");",
      "\t}",
      "} else if (${1} == \"Triángulo equilátero\") {",
      "\tfor (int i = 1; i <= n; i++) {",
      "\t\tfor (int j = i; j < n; j++) {",
      "\t\t\tprintf(\" \");",
      "\t\t}",
      "\t\tfor (int j = 1; j <= (2*i-1); j++) {",
      "\t\t\tprintf(\"*\");",
      "\t\t}",
      "\t\tprintf(\"\\n\");",
      "\t}",
      "} else if (${1} == \"Pirámide\") {",
      "\tfor (int i = 1; i <= n; i++) {",
      "\t\tfor (int j = i; j < n; j++) printf(\" \");",
      "\t\tfor (int j = 1; j <= (2*i-1); j++) printf(\"*\");",
      "\t\tprintf(\"\\n\");",
      "\t}",
      "} else if (${1} == \"Rombo\") {",
      "\tfor (int i = 1; i <= n; i++) {",
      "\t\tfor (int j = i; j < n; j++) printf(\" \");",
      "\t\tfor (int j = 1; j <= (2*i-1); j++) printf(\"*\");",
      "\t\tprintf(\"\\n\");",
      "\t}",
      "\tfor (int i = n-1; i >= 1; i--) {",
      "\t\tfor (int j = n; j > i; j--) printf(\" \");",
      "\t\tfor (int j = 1; j <= (2*i-1); j++) printf(\"*\");",
      "\t\tprintf(\"\\n\");",
      "\t}",
      "}"
    ],
    "description": "Genera código para dibujar figuras con asteriscos"
  },


      "int es_palindromo(const char *cadena) {",
      "\tint izquierda = 0;",
      "\tint derecha = strlen(cadena) - 1;",
      "\twhile (izquierda < derecha) {",
      "\t\tif (cadena[izquierda] != cadena[derecha]) return 0;",
      "\t\tizquierda++;",
      "\t\tderecha--;",
      "\t}",
      "\treturn 1;",
      "}",
      "",
      "// Uso:",
      "if (es_palindromo(\"${1:anilina}\")) printf(\"Es palíndromo\\n\");"
    ],
    "description": "Verifica si una cadena es palíndromo"
  },



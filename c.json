      "",
      "// Insertar al inicio",
      "void insertar_inicio(Nodo **cabeza, ${1} valor) {",
      "\tNodo *nuevo = (Nodo*)malloc(sizeof(Nodo));",
      "\tnuevo->dato = valor;",
      "\tnuevo->siguiente = *cabeza;",
      "\t*cabeza = nuevo;",
      "}",
      "",
      "// Recorrer e imprimir",
